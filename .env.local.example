# ==========================
# SAZAIRA — Environment Variables Example
# ==========================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# ==========================

# ── Supabase Database Configuration (Step 8) ─────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings (gear icon) → API
# or Project Settings → Data API

# 1. Project URL (Public) — Safe to expose in browser
# Found in Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Anon / Public Key — Safe for client-side queries (protected by RLS)
# Found in Supabase Dashboard → Settings → API → Project API Keys → `anon` `public`
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. ⚠️ SERVICE ROLE SECRET KEY — MUST NEVER BE EXPOSED TO THE CLIENT!
# Grants unrestricted server-side access, bypassing Row Level Security.
# Only used in Route Handlers (/api/orders) to write orders securely.
# Found in Supabase Dashboard → Settings → API → Project API Keys → `service_role` `secret`
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ── WhatsApp Integration ─────────────────────────────────────────────────────
# Pakistani international format without '+' or leading '0' (e.g. 923037321336)
NEXT_PUBLIC_WHATSAPP_PHONE=923037321336

# ── Site / General Config ────────────────────────────────────────────────────
# The public URL of your site (used for generating absolute URLs in metadata & keep-alive)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
